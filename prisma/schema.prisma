generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ===========================
// AUTH
// ===========================
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  passwordSalt String
  createdAt    DateTime @default(now())
}

// ===========================
// CATALOG
// ===========================
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  image       String?
  // Optional banner shown at the top of this collection's detail page.
  // All optional and admin-entered — falls back to the collection's own
  // name/image when empty, never fabricated.
  bannerImage   String?
  bannerTitle   String?
  bannerTagline String?
  bannerCtaText String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  showInNav   Boolean  @default(true)
  // When true, this collection's products are sold ONLY as part of a Pack —
  // the storefront hides standalone add-to-cart for them and routes browsing
  // straight into the pack chooser. Off by default so existing collections
  // (e.g. gel douche) keep selling individually exactly as before.
  packOnly    Boolean  @default(false)
  // Per-collection storefront toolbar toggles (collection detail page).
  // Both default to today's behavior for every existing collection: the
  // search bar was already always shown, and no custom filter existed yet.
  showSearch  Boolean  @default(true)
  showFilter  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products             Product[]
  packs                Pack[]
  freePackCollections  FreePackEligibleCollection[]
  promoCodeCollections PromoCodeCollection[]
  bundles              Bundle[] @relation("BundleCollections")
  filterOptions        CollectionFilterOption[]
}

// Admin-defined filter chip labels, scoped to one collection (e.g. for
// "Cosmetics": Soin visage / Corps / Cheveux). Only used when that
// collection's `showFilter` is on. Products tag themselves against these via
// Product.filterOptionIds (same JSON-array-of-ids pattern as genders).
model CollectionFilterOption {
  id           String @id @default(cuid())
  label        String
  position     Int    @default(0)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String?
  notes             String?
  notesTop          String?
  notesHeart        String?
  notesBase         String?
  // Structured olfactory pyramid — JSON array of {name, image}. Optional and
  // additive: the plain notesTop/notesHeart/notesBase strings above are never
  // touched, so existing products keep working exactly as before. The
  // storefront prefers this structured data when present, and falls back to
  // splitting the plain string (name only, no image) otherwise.
  notesTopData      String   @default("[]")
  notesHeartData    String   @default("[]")
  notesBaseData     String   @default("[]")
  ingredients       String?
  usage             String?
  deliveryInfo      String?
  benefits          String   @default("[]") // JSON array of short product-specific claims, all admin-entered
  gender            String? // legacy single value — kept for backward compatibility, no longer written to
  genders           String   @default("[]") // JSON array — a product can belong to several genders at once (e.g. Homme + Femme)
  filterOptionIds   String   @default("[]") // JSON array of CollectionFilterOption ids this product is tagged with (its own collection's custom filter)
  volume            String?  @default("50ML")
  price             Float
  // Admin-entered cost basis per unit, used only to compute Profit on an
  // order once it's Delivered — never shown to customers, never affects
  // the selling price.
  costPrice         Float?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  images            String   @default("[]") // JSON array of URLs
  videoUrl          String?
  shape             String   @default("bottle") // bottle | jar | tube
  color             String   @default("#0c0c0c")
  isActive          Boolean  @default(true)
  isNew             Boolean  @default(false)
  isBestSeller      Boolean  @default(false)
  isLimitedEdition  Boolean  @default(false)
  packEligible      Boolean  @default(true)
  freePackEligible  Boolean  @default(false)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Flash Sale — a temporary promotional price. `price` above is never
  // overwritten; the effective price is resolved at read/checkout time from
  // these fields so the "normal price" is always safely recoverable.
  flashSaleActive Boolean   @default(false)
  flashSalePrice  Float?
  flashSaleStart  DateTime?
  flashSaleEnd    DateTime?
  flashSaleLabel  String?

  // Optional link to a named, multi-product Campaign (e.g. "RAMADAN SALE").
  // When set, the storefront countdown reads the campaign's shared
  // start/end instead of this product's own flashSale* dates, so every
  // product in the same campaign counts down in sync. The product's own
  // flashSaleActive/flashSalePrice/flashSaleLabel still decide the actual
  // discounted price shown — purely additive, nothing changes for a
  // product with no campaignId.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])

  packProducts        PackProduct[]
  freePackProducts     FreePackEligibleProduct[]
  orderItems           OrderItem[]
  orderItemComponents  OrderItemComponent[]
  stockLogs            StockLog[]
  promoCodeProducts    PromoCodeProduct[]
  bundleItems          BundleItem[]
  reviews              Review[]
  characteristics      ProductCharacteristic[]
}

// ===========================
// FRAGRANCE CHARACTERISTICS — shared tag vocabulary used to (a) tag products
// for the "Find Your Scent" quiz matching and (b) power smarter search.
// Admin-managed (add/rename/reorder/delete) — no hardcoded tag list.
// ===========================
model Characteristic {
  id       String @id @default(cuid())
  name     String @unique
  position Int    @default(0)

  products        ProductCharacteristic[]
  quizAnswerLinks QuizAnswerCharacteristic[]
}

// ===========================
// "FIND YOUR SCENT" QUIZ — fully dashboard-configurable, no hardcoded
// recommendation logic. Each answer maps to one or more Characteristics
// (with a weight); a customer's answers are scored against each product's
// tagged Characteristics to produce a ranked match list.
// ===========================
model QuizQuestion {
  id       String  @id @default(cuid())
  text     String
  position Int     @default(0)
  isActive Boolean @default(true)

  answers QuizAnswer[]
}

model QuizAnswer {
  id       String @id @default(cuid())
  label    String
  position Int    @default(0)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  characteristics QuizAnswerCharacteristic[]
}

model QuizAnswerCharacteristic {
  answerId         String
  characteristicId String
  weight           Int    @default(1)
  answer           QuizAnswer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@id([answerId, characteristicId])
}

model ProductCharacteristic {
  productId        String
  characteristicId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@id([productId, characteristicId])
}

// ===========================
// PACKS (classic: fixed size, customer picks N eligible items)
// ===========================
model Pack {
  id                      String   @id @default(cuid())
  name                    String
  size                    Int // number of items required
  price                   Float
  isCustomizable          Boolean  @default(true) // client picks any eligible items
  useCollectionEligibility Boolean @default(true) // true = whole collection eligible, false = use explicit PackProduct list
  // Optional marketing presentation, admin-entered, never fabricated —
  // falls back to the existing size/price display when empty.
  image                   String?
  tagline                 String?
  blurb                   String?
  isActive                Boolean  @default(true)
  position                Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])

  eligibleProducts  PackProduct[]
  orderItems        OrderItem[]
  promoCodePacks    PromoCodePack[]
}

model PackProduct {
  packId    String
  productId String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([packId, productId])
}

// ===========================
// FREE PACK (cross-collection, admin-defined eligibility rules)
// ===========================
model FreePackConfig {
  id                 String   @id @default(cuid())
  name               String   @default("FREE PACK")
  minItems           Int      @default(3)
  allowMixCategories Boolean  @default(true)
  // Legacy threshold/flat-total rule — superseded by the per-item pricing
  // below, kept only so no historical data is lost.
  priceThreshold     Float    @default(150)
  flatPrice          Float    @default(66.34)
  // Per-item Free Pack pricing: each selected item is priced individually
  // based on its category — a perfume always costs perfumePrice, a gel
  // douche always costs gelDouchePrice, regardless of how many are picked.
  perfumePrice       Float    @default(66.34)
  gelDouchePrice     Float    @default(79)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  eligibleCollections FreePackEligibleCollection[]
  eligibleProducts    FreePackEligibleProduct[]
}

model FreePackEligibleCollection {
  freePackConfigId String
  collectionId     String
  freePackConfig   FreePackConfig @relation(fields: [freePackConfigId], references: [id], onDelete: Cascade)
  collection       Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([freePackConfigId, collectionId])
}

model FreePackEligibleProduct {
  freePackConfigId String
  productId        String
  freePackConfig   FreePackConfig @relation(fields: [freePackConfigId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([freePackConfigId, productId])
}

// ===========================
// PROMO CODES
// ===========================
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String // PERCENT | FIXED
  value          Float
  expiresAt      DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  minOrderAmount Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  eligibleProducts    PromoCodeProduct[]
  eligiblePacks       PromoCodePack[]
  eligibleCollections PromoCodeCollection[]
  orders              Order[]
}

model PromoCodeProduct {
  promoCodeId String
  productId   String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, productId])
}

model PromoCodePack {
  promoCodeId String
  packId      String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  pack        Pack      @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, packId])
}

model PromoCodeCollection {
  promoCodeId  String
  collectionId String
  promoCode    PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, collectionId])
}

// ===========================
// CUSTOMERS & ORDERS
// ===========================
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  address   String
  city      String
  createdAt DateTime @default(now())

  orders        Order[]
  loyaltyLedger LoyaltyLedger[]
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  clientOrderId  String?  @unique
  fullName       String
  phone          String
  address        String
  city           String
  subtotal       Float
  discountAmount Float    @default(0)
  deliveryFee    Float    @default(0)
  total          Float
  status         String   @default("PENDING") // PENDING|CONFIRMED|PREPARING|SHIPPED|DELIVERED|CANCELLED
  // Frozen the moment this order first transitions to DELIVERED (revenue
  // minus each item's product cost basis) — never recomputed on a later
  // save of the same status, and never counted before delivery. Stays null
  // until then. "Accumulated profit" is simply the live sum of this column
  // across every order currently DELIVERED, so an order that's later
  // cancelled naturally drops out of that total without a manual reversal.
  profit         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  items         OrderItem[]
  loyaltyLedger LoyaltyLedger[]
  reviews       Review[]
}

model OrderItem {
  id         String  @id @default(cuid())
  kind       String // PRODUCT | PACK | FREE_PACK
  name       String
  unitPrice  Float
  quantity   Int     @default(1)
  detail     String? // human-readable snapshot (e.g. fragrance list)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  packId String?
  pack   Pack?   @relation(fields: [packId], references: [id])

  bundleId String?
  bundle   Bundle? @relation(fields: [bundleId], references: [id])

  components OrderItemComponent[]
}

model OrderItemComponent {
  id          String @id @default(cuid())
  name        String

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model StockLog {
  id             String   @id @default(cuid())
  changeAmount   Int
  reason         String
  resultingStock Int
  createdAt      DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ===========================
// HOMEPAGE BUILDER
// ===========================
model HeroSlide {
  id               String   @id @default(cuid())
  eyebrow          String?
  title            String?
  subtitle         String?
  imageUrl         String?
  videoUrl         String?
  gradientFallback String?
  ctaText1         String?
  ctaHref1         String?
  ctaText2         String?
  ctaHref2         String?
  position         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  type      String // FEATURED_PRODUCTS | FEATURED_COLLECTIONS | BEST_SELLERS | NEW_ARRIVALS | PROMO_BANNER | TEXT_IMAGE | TESTIMONIALS
  title     String?
  subtitle  String?
  config    String   @default("{}") // JSON, shape depends on `type`
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Homepage video showcase — admin-managed (add/remove/reorder), rendered as
// its own section right after the existing dynamic homepage sections.
// Kept as its own model (mirroring HeroSlide) rather than another
// HomepageSection JSON blob, so the admin gets a real add/remove/reorder
// list UI with file upload instead of hand-edited JSON.
model HomepageVideo {
  id          String   @id @default(cuid())
  title       String?
  videoUrl    String
  posterImage String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================
// NAVBAR (admin-managed static links; the "Collections" dropdown
// itself is always derived live from the Collection table, not stored here)
// ===========================
model NavMenuItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================
// LOYALTY PROGRAM
// ===========================
model LoyaltySettings {
  id             String   @id @default(cuid())
  amountPerPoint Float    @default(199) // orderTotal / amountPerPoint = points earned — Perfumes + Gel Douche
  // Cosmetics + Supplements earn at their own, separate rate — never mixed
  // with amountPerPoint above. An order spanning both categories earns
  // points from each portion of its revenue at its own rate.
  amountPerPointSecondary Float @default(299)
  isActive       Boolean  @default(true)
  // Admin-editable "how points work" text shown on the public Fidélité page.
  // Null/empty falls back to the site's original generic wording — this
  // field only overrides it once an admin actually fills it in.
  pointsExplanation String? @db.Text
  updatedAt      DateTime @updatedAt
}

model LoyaltyReward {
  id               String   @id @default(cuid())
  name             String
  description      String?
  pointsRequired   Float
  productsIncluded String?  // free-form description of what's included
  redemptionLimit  Int?
  isActive         Boolean  @default(true)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  redemptions LoyaltyLedger[]
}

model LoyaltyLedger {
  id        String   @id @default(cuid())
  type      String // EARNED | MANUAL_ADD | MANUAL_REMOVE | REDEEMED | REVERSED
  points    Float // positive = credit, negative = debit
  note      String?
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  rewardId String?
  reward   LoyaltyReward? @relation(fields: [rewardId], references: [id])

  reversesEntryId String?
}

// Customer-initiated "claim my points" request — distinct from the ledger:
// this is a request queue for the admin to action (contact the customer,
// hand over the reward, mark it done), not a points movement by itself.
model LoyaltyRedemptionRequest {
  id                 String   @id @default(cuid())
  fullName           String
  phone              String
  pointsAtRequest    Float
  requestedRewardId  String?
  requestedRewardName String?
  status             String   @default("PENDING") // PENDING | CONTACTED | COMPLETED | REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ===========================
// BUNDLES — fixed, admin-curated product sets at a custom flat price.
// Independent from the classic Pack system (no customer choice involved).
// ===========================
model Bundle {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  image       String?
  price       Float
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       BundleItem[]
  orderItems  OrderItem[]
  // Which collections this bundle shows up in, displayed inline alongside
  // normal products (not a separate "Bundles" section). Many-to-many so an
  // admin can place the same bundle in several collections at once.
  collections Collection[] @relation("BundleCollections")
}

model BundleItem {
  bundleId  String
  productId String
  quantity  Int    @default(1)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

// ===========================
// REVIEWS — submitted after a delivered order, hidden until admin-approved.
// ===========================
model FunnelEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  event     String
  label     String?

  @@index([event, createdAt])
  @@index([sessionId])
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  text         String?
  customerName String?
  customerPhoto   String?
  customerVideo   String?
  showOnHomepage  Boolean  @default(false)
  position        Int      @default(0)
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
}

// Site-wide Review behavior, admin-configurable (singleton row).
model ReviewSettings {
  id               String   @id @default(cuid())
  isEnabled        Boolean  @default(true)
  minRating        Int      @default(1)
  requireApproval  Boolean  @default(true)
  autoApprove      Boolean  @default(false)
  showCustomerName Boolean  @default(true)
  sortOrder        String   @default("recent") // recent | rating_high | rating_low | featured
  displayCount     Int      @default(10)
  updatedAt        DateTime @updatedAt
}

// ===========================
// SITE SETTINGS (WhatsApp, Instagram, misc storefront text)
// ===========================
model SiteSettings {
  id                String   @id @default(cuid())
  whatsappNumber    String?
  instagramLink     String?
  instagramQrImage  String?
  perfumeDisclaimer String   @default("Inspiré des plus grands parfums — non affilié aux marques citées.")
  defaultTheme      String   @default("clair") // clair | sombre — the visitor's own choice (localStorage) still overrides this
  announcementText  String   @default("Livraison offerte partout au Maroc")
  // Optional JSON array of extra rotating messages shown alongside
  // announcementText. Empty by default — existing single-message behavior
  // is unchanged until the admin adds messages here.
  announcementMessages String @default("[]")
  trustSignals      String   @default("[]") // JSON array of admin-entered trust statements
  metaPixelId       String?  // Meta (Facebook) Pixel ID — the storefront only loads the Pixel script when this is set
  updatedAt         DateTime @updatedAt
}

// ===========================
// PROMOTIONAL CAMPAIGNS (named, multi-product sales — "FRESH SALE",
// "RAMADAN SALE", etc.) — a thin grouping layer on top of the existing
// per-product Flash Sale fields. A campaign itself never sets a price; it
// just gives several products' flash sales a shared name, banner and
// countdown so they run in sync, and tells the storefront which sections
// are allowed to surface that countdown.
// ===========================
model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  bannerImage String?
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean   @default(true)
  // Where this campaign's countdown may appear — admin-controlled, all
  // default true so existing behavior (show everywhere) is preserved.
  showOnHomepage     Boolean @default(true)
  showOnProductCards Boolean @default(true)
  showOnProductPage  Boolean @default(true)
  showOnBundles      Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

// ===========================
// FAQ — one flat table reused in two places: the storefront accordion
// (section-scoped via `page`, or global when `page` is null) and the
// guided support chat (grouped by `category`). No separate chat-content
// table — same admin-entered Q&A powers both, per the cost-optimization
// rule against duplicate tables.
// ===========================
model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String? // e.g. Livraison, Paiement, Commandes, Produits, Fidélité, Promotions — used by the chat's category menu
  // null = shown on every page's FAQ section; otherwise a page key like
  // "home" | "product" | "collection" | "loyalty" | "contact" restricts it
  // to that page only.
  page     String?
  position Int     @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
