# Postgres connection (Neon, Supabase, Vercel Postgres, or any Postgres host).
# DATABASE_URL is the one the app queries through at runtime — on Neon this
# is the pooled connection string (contains "-pooler" in the host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DATABASE_URL_UNPOOLED is the same database but WITHOUT the pooler in
# front — Prisma uses it only for running migrations. This is the exact
# variable name Vercel's native Neon integration auto-injects; if your
# provider uses a different name (e.g. plain Neon.com), just rename it here
# and in prisma/schema.prisma's `directUrl`.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Signs the admin login session cookie. Set this to a long random string in
# every real deployment — the app falls back to an insecure default locally.
SESSION_SECRET="replace-with-a-long-random-string"

# Media storage (product/pack/collection images and videos) — Supabase
# Storage project. From your Supabase project: Settings > API.
#
# SUPABASE_URL — the Project URL (e.g. https://xxxx.supabase.co).
#
# SUPABASE_ANON_KEY — the "anon" / "public" key. Safe to expose to the
# browser (the admin upload page needs it to upload videos directly to
# Supabase) — it only grants what your storage policies allow.
#
# SUPABASE_SERVICE_ROLE_KEY — server-only, never sent to the browser. Used
# for server-side uploads and for creating the signed upload URLs videos
# use. Treat it like a database password.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="replace-with-your-project-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-project-service-role-key"
