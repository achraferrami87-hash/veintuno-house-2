# Postgres connection (Neon, Supabase, Vercel Postgres, or any Postgres host).
# DATABASE_URL is the one the app queries through at runtime — on Neon this
# is the pooled connection string (contains "-pooler" in the host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DIRECT_URL is the same database but WITHOUT the pooler in front — Prisma
# uses it only for running migrations. On Neon this is the non-pooled
# connection string. If your provider doesn't offer a separate pooled
# endpoint, DIRECT_URL can be identical to DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the admin login session cookie. Set this to a long random string in
# every real deployment — the app falls back to an insecure default locally.
SESSION_SECRET="replace-with-a-long-random-string"

# Vercel Blob token, used to store uploaded product/QR/review images and
# videos. Generated automatically when you attach a Blob store to your
# Vercel project (Storage tab) — copy it from there.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
